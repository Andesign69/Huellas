# Copia a infra/.env y llena los valores reales antes de `docker compose up`.
# infra/.env nunca se sube a git (mismo patrón que .env.local.example en la raíz).
#
# Generar passwords con `openssl rand -hex 24`, NO `-base64`: base64 puede
# incluir "/", "+", "=", y estos van embebidos en un DATABASE_URL tipo URI
# — un "/" sin escapar en la password rompe el parseo (se confunde con el
# separador de path). Encontrado en vivo desplegando este mismo chapter:
# app-prod quedó "unhealthy" porque openssl -base64 generó una password con
# "/" y pg-connection-string la parseó mal. hex solo usa [0-9a-f], siempre
# seguro dentro de una URI.

# Superusuario de Postgres — solo se usa para crear las DBs/roles al iniciar
# el contenedor por primera vez, la app nunca conecta con este usuario.
POSTGRES_USER=huellas_admin
POSTGRES_PASSWORD=

# Passwords de los roles de la app — DISTINTOS entre sí a propósito (ver el
# comentario al inicio de supabase/schema.sql): así una password de staging
# filtrada no da acceso a prod.
HUELLAS_APP_PASSWORD_PROD=
HUELLAS_APP_PASSWORD_STAGING=

# Opcional — mismo valor que en .env.local.example de la raíz.
NEXT_PUBLIC_MAPTILER_KEY=
