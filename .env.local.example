# Copia este archivo a .env.local y llena los valores. .env.local nunca se sube a git.

# Project Settings > API en tu proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Opcional: key gratuita de https://cloud.maptiler.com (Maps > Keys).
# Sin esta variable, el mapa usa tiles públicos de OpenStreetMap (sirve para
# desarrollo local, pero no aguanta tráfico real de producción).
NEXT_PUBLIC_MAPTILER_KEY=

# Opcional: access key gratuita de https://web3forms.com (solo pide un correo,
# sin contraseña). Sin esta variable, "Sugerir un refugio" igual guarda en
# Supabase pero no manda el aviso por correo.
NEXT_PUBLIC_WEB3FORMS_KEY=
