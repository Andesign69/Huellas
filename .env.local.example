# Copia este archivo a .env.local y llena los valores. .env.local nunca se sube a git.

# Postgres self-hosteado (ver docs/adr/0001-vps-migration.md). Para desarrollo
# local: docker compose -f docker-compose.dev.yml up -d, luego aplicar
# supabase/schema.sql y darle password al rol huellas_app (ver comentario al
# inicio de ese archivo). No es la cuenta owner — conecta como huellas_app.
DATABASE_URL=postgres://huellas_app:CHANGEME@localhost:5432/huellas_dev

# Dónde se guardan las fotos subidas. Local: cualquier carpeta (se crea sola).
# Prod/staging: /srv/huellas/uploads/{prod,staging} (WBS Chapter 7), servida
# por nginx directo — en local la sirve src/app/photos/[...path]/route.ts.
UPLOADS_DIR=./.data/uploads

# Opcional: key gratuita de https://cloud.maptiler.com (Maps > Keys).
# Sin esta variable, el mapa usa tiles públicos de OpenStreetMap (sirve para
# desarrollo local, pero no aguanta tráfico real de producción).
NEXT_PUBLIC_MAPTILER_KEY=

# Password para /admin (banderas de contenido + sugerencias de refugio).
# Sin esta variable, /admin queda inaccesible (login siempre rechaza).
ADMIN_PASSWORD=
